#Report + ALL
// State map: n=1, m=1 (per AGV: local mode + count_x).
// After first delivery: DELIVERED(c=1) --1--> MOVING(c=1) (one step in delivered).
// s0: a0:moving,c=0
// s1: a0:waiting,c=0
// s2: a0:collided,c=0
// s3: a0:delivered,c=1
// s4: a0:done,c=1

dtmc agv:={
state s0,s1,s2,s3,s4;
init(s0:1);
  arcs(
  s0 : s0 :0.25,
  s0 : s1 :0.1,
  s0 : s2 :0.05,
  s0 : s3 :0.6,
  s1 : s0 :0.98,
  s1 : s2 :0.02,
  s2 : s0 :1,
  s3 : s4 :1,
  s4 : s4 :1
  );

// re: rate(s) = #AGVs in local DELIVERED (equivalent to impulse-on-enter-DELIVERED while each visit lasts 1 step).
statevect re:= reward(s3:1);
stateset success := potential(in_state({s4}));
stateset collided := potential(in_state({s2}));
statevect res := cond_acc_reward(10,success,re,collided);
};
print("read model\n");
print(" cond expected acc reward for test MC ", agv.res, "\n");
