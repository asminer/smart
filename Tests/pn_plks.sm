/* 
   Petri net plKS.
*/

// #Warning + pn_ALL

#GraphDisplayStyle OUTGOING
#StatesetPrintIndexes false

pn plks := {
  place p00, p01, p10, p11, samples_max, samples, battery;

  trans t00_01, t00_10,
        t01_11, t01_00, 
        t10_11, t10_00,
        t11_10, t11_01,
        samples_t;

  init(p00:1, samples_max:2, battery:3);

  arcs(
      p00 : t00_01, p00 : t00_10,
      p01 : t01_11, p01 : t01_00,
      p10 : t10_11, p10 : t10_00,
      p11 : t11_10, p11 : t11_01,
      t00_01 : p01, t00_10 : p10,
      t01_11 : p11, t01_00 : p00,
      t10_11 : p11, t10_00 : p00,
      t11_10 : p10, t11_01 : p01,
      samples_max : samples_t,
      samples_t : samples,
      battery : t00_01, battery : t00_10, 
      battery : t01_11, battery : t01_00, 
      battery : t10_11, battery : t10_00,
      battery : t11_10, battery : t11_01
  );

  guard(samples_t:tk(p01)==1 | tk(p10)==1 );

  decision s_min1, s_min2;
  enable_decision(s_min1:(!is_taken(s_min2)), s_min2:(!is_taken(s_min1)));

  bigint n_states := num_states;
  bigint n_arcs := num_arcs;
  stateset r := reachable;

  stateset prop := (potential(tk(p00)==1)) -> EU(reachable, potential(tk(p11)==1) & 
                                                (potential(tk(battery) > 0)) &
                                                ((potential(dec_value(s_min1) & tk(samples)>0)) |
                                                 (potential(dec_value(s_min2) & tk(samples)>1))));

  bool test := min_decision_cost(prop);
};

print(plks.n_states,"\n");
print(plks.n_arcs,"\n");
print(plks.r,"\n");
print("\n");
print(plks.test,"\n");