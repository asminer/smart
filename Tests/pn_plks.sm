/* 
   Petri net plKS.
*/

/*

              0               1           ...        2N-2   

  2N-2     p[0][2N-2] --> tc[2N-2][1] --> ...     p[2N-2][2N-2]
 
  ...        ...             ...          ...        ...

  4         p[0][4] ------> tc[4][1] ---> ...
            ^     |
            |     v
  3   tc0[3][0]  tc1[3][0]                ...
            |     ^
            v     |
  2         p[0][2] ------> tc[2][1] ---> ...
            ^     |
            |     v
  1   tc0[0][1]  tc1[0][1]                ...
            ^     |
            |     v
  0         p[0][0] ------> tc[0][1] ---> ...

*/

// #Warning + pn_ALL

#GraphDisplayStyle OUTGOING
#StatesetPrintIndexes false

pn plks(int N) := {
  place battery, sample_20, sample_02, samples;
  trans sample_20_take, sample_02_take;

  for (int i in {0..N+(N-2)..2}, int j in {0..N+(N-2)..2}) {
    place p[i][j];
  }

  for (int i in {1..N+(N-2)..2}, int j in {0..N+(N-2)..2}) {
    trans tr0[i][j];
    trans tr1[i][j];
  }

  for (int i in {0..N+(N-2)..2}, int j in {1..N+(N-2)..2}) {
    trans tc0[i][j];
    trans tc1[i][j];
  }

  init(p[0][0]:1, battery:7, sample_02:1, sample_20:1);

  for (int i in {0..N+(N-4)..2}, int j in {0..N+(N-2)..2}) {
    arcs(p[i][j] : tr0[i+1][j],
         tr0[i+1][j] : p[i+2][j],
         p[i+2][j] : tr1[i+1][j],
         tr1[i+1][j] : p[i][j]
    );
  }

  for (int i in {0..N+(N-2)..2}, int j in {0..N+(N-4)..2}) {
    arcs(p[i][j] : tc0[i][j+1],
         tc0[i][j+1] : p[i][j+2],
         p[i][j+2] : tc1[i][j+1],
         tc1[i][j+1] : p[i][j]
    );
  }

  for (int i in {1..N+(N-2)..2}, int j in {0..N+(N-2)..2}) {
    arcs(battery : tr0[i][j],
         battery : tr1[i][j]);
  }

  for (int i in {0..N+(N-2)..2}, int j in {1..N+(N-2)..2}) {
    arcs(battery : tc0[i][j],
         battery : tc1[i][j]);
  }

  arcs(sample_02 : sample_02_take, sample_20 : sample_20_take,
       sample_02_take : samples, sample_20_take : samples);

  guard(sample_20_take : tk(p[2][0]) > 0, sample_02_take : tk(p[0][2]) > 0);

  decision s_min1, s_min2;
  
  enable_decision(s_min1:(!is_taken(s_min2)), s_min2:(!is_taken(s_min1)));

  //decision s_min2;

  bigint n_states := num_states;
  bigint n_arcs := num_arcs;
  stateset r := reachable;

  stateset prop := (potential(tk(p[0][0])==1)) -> EU(reachable, potential(tk(p[N+(N-2)][N+(N-2)])==1) & 
                                                (potential(tk(battery) > 0)) &
                                                ((potential(dec_value(s_min1) & tk(samples)>0)) |
                                                 (potential(dec_value(s_min2) & tk(samples)>1))));

  /*
  stateset prop := (potential(tk(p[0][0])==1)) -> EU(reachable, potential(tk(p[N+(N-2)][N+(N-2)])==1) & 
                                                (potential(tk(battery) > 0)) &
                                                (potential(dec_value(s_min2) & tk(samples)>1)));
  */

  bool test := min_decision_cost(prop);
};

print(plks(4).n_states,"\n");
print(plks(4).n_arcs,"\n");
print(plks(4).r,"\n");
print("--------\n");
print(plks(4).test,"\n");
