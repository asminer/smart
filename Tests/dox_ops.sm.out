Help topic: binary ,
    Operator , is used for set union (inside {}). It may be used with the 
    following operand types:
    
    event ,
        {event}     has type: {event}
    
    {event} ,
        event       has type: {event}
        {event}     has type: {event}
    
    glue ,
        {glue}      has type: {glue}
    
    {glue} ,
        glue        has type: {glue}
        {glue}      has type: {glue}
    
    int ,
        {int}       has type: {int}
        {real}      has type: {real}
    
    {int} ,
        int         has type: {int}
        {int}       has type: {int}
        real        has type: {real}
        {real}      has type: {real}
    
    intvar ,
        {intvar}        has type: {intvar}
    
    {intvar} ,
        intvar          has type: {intvar}
        {intvar}        has type: {intvar}
    
    place ,
        {place}     has type: {place}
    
    {place} ,
        place       has type: {place}
        {place}     has type: {place}
    
    real ,
        {int}       has type: {real}
        {real}      has type: {real}
    
    {real} ,
        int         has type: {real}
        {int}       has type: {real}
        real        has type: {real}
        {real}      has type: {real}
    
    state ,
        {state}     has type: {state}
    
    {state} ,
        state       has type: {state}
        {state}     has type: {state}
    
    tile ,
        {tile}      has type: {tile}
    
    {tile} ,
        tile        has type: {tile}
        {tile}      has type: {tile}
    
    trans ,
        {trans}     has type: {trans}
    
    {trans} ,
        trans       has type: {trans}
        {trans}     has type: {trans}

