

dtmc fiveCtwo :={
	state s1,s2,s3,s4,s5,s6;
	init(s1:1);
	arcs(
	s1: s1:0.95099,
	s1:s2:0.05,
	s1:s3:0.001,
	s1:s4:0.00001,
	s1:s5:0.00000005,
	s1:s6:0.0000000001,
	s2:s2:0.960596,
	s2:s3: 0.04,
	s2:s4:0.0006,
	s2:s5:0.000004,
	s2:s6: 0.00000001,
	s3:s3:0.970299,
	s3:s4:0.03,
	s3:s5:0.0003,
	s3:s6:0.000001,
	s4:s4:0.9801,
	s4:s5:0.02,
	s4:s6:0.0001,
	s5:s5:1,
	s6:s6:1
	);

stateset abs := potential(is_absorbed);
//stateset bad := potential(abs);
stateset good := !abs;
stateset timed := !(EX(abs)| abs);
stateprobs prop2:= conditional_tta(10,500,abs,!abs);
}
;
print("absorbing states ", fiveCtwo.abs, "\n");
print("conditional states ", fiveCtwo.prop2,"\n");

