dtmc cond_test :={

state s1,s2,s3,s4;
init(s1:1);
arcs(
	
s1:s1:0.729,
s1:s2: 0.243,
s1:s3:0.027,
s1:s4:0.001,
s2:s2: 0.81,
s2:s3: 0.18,
s2:s4: 0.01,
s3:s3:1,
s4:s4:1
);	
stateset abs := potential(is_absorbed);
stateset bad := potential(in_state({s3,s4}));
stateset good := !bad;
stateset timed := !(EX(abs)| abs);
stateprobs prop2:= conditional_tta(2,3,bad,good);

};


print("test for filtering timed: ", cond_test.bad, "\n");

print("test2:::::::::",cond_test.prop2,"\n");