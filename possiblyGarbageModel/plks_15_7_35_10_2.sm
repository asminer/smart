    bigint n_states := num_states;
    stateset prop := (potential(tk(p0_0)==1)) -> EU(reachable, potential( (tk(p14_14)==1) & ( (dec_value(battery_min1) & tk(battery) > 0))|(dec_value(battery_min2) & tk(battery) > 1))|(dec_value(battery_min3) & tk(battery) > 3))|(dec_value(battery_min4) & tk(battery) > 5))|(dec_value(battery_min5) & tk(battery) > 7))) & (((dec_value(s_min1) & tk(samples)>0))|((dec_value(s_min2) & tk(samples)>1))|((dec_value(s_min3) & tk(samples)>2))|((dec_value(s_min4) & tk(samples)>3))|((dec_value(s_min5) & tk(samples)>4))|((dec_value(s_min6) & tk(samples)>5))|((dec_value(s_min7) & tk(samples)>6))));
